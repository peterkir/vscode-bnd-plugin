    "walkthroughs": [
      {
        "id": "bnd.walkthrough",
        "title": "Get Started with bnd / bndtools",
        "description": "Learn the features of this extension: syntax highlighting, IntelliSense, hover docs, and integrated CLI commands.",
        "steps": [
          {
            "id": "bnd.walkthrough.start",
            "title": "Overview",
            "description": "This extension activates automatically for bnd files and provides syntax highlighting, completions, hover documentation, and 23 integrated bnd CLI commands.",
            "media": {
              "markdown": "walkthroughs/01-getting-started.md"
            }
          },
          {
            "id": "bnd.walkthrough.completions",
            "title": "IntelliSense Completions",
            "description": "Press `Ctrl+Space` on a new line to browse instructions and headers, or type `${` to trigger macro completions.",
            "media": {
              "markdown": "walkthroughs/02-completions.md"
            }
          },
          {
            "id": "bnd.walkthrough.hover",
            "title": "Hover Documentation",
            "description": "Hover over any instruction, header, or macro name to see its signature, description, and a ready-to-use example.",
            "media": {
              "markdown": "walkthroughs/03-hover-docs.md"
            }
          },
          {
            "id": "bnd.walkthrough.cli",
            "title": "Integrated CLI Commands",
            "description": "All bnd CLI commands are available from the Command Palette under the `Bnd:` prefix. The extension downloads and configures the latest bnd release automatically; use Bnd: Configure bnd Library... to switch to another release, a snapshot, or your own URL.",
            "media": {
              "markdown": "walkthroughs/04-cli-commands.md"
            }
          },
          {
            "id": "bnd.walkthrough.reference",
            "title": "CLI Reference Panel",
            "description": "Run **Bnd: Show CLI Reference** to open a searchable panel covering all 77 bnd CLI sub-commands with options and examples.",
            "completionEvents": [
              "onCommand:bnd.cli.showReference"
            ],
            "media": {
              "markdown": "walkthroughs/05-cli-reference.md"
            }
          },
          {
            "id": "bnd.walkthrough.launch",
            "title": "Run and Debug OSGi Frameworks",
            "description": "Use the Run and Debug CodeLens on .bndrun and bnd.bnd files, or add a `bnd` launch configuration, to start and debug OSGi frameworks and tests with the Java debugger.",
            "media": {
              "markdown": "walkthroughs/06-launch-debug.md"
            }
          },
          {
            "id": "bnd.walkthrough.repositories",
            "title": "Browse Repositories",
            "description": "Open the bnd view in the Activity Bar to browse workspace and plugin repositories, search for capabilities, and drag bundles into -buildpath or -runbundles.\n[Show Repositories](command:bnd.repositories.focus)",
            "completionEvents": [
              "onView:bnd.repositories"
            ],
            "media": {
              "markdown": "walkthroughs/07-repositories.md"
            }
          }
        ]
      }
    ],
