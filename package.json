{
  "name": "bnd",
  "displayName": "bnd / bndtools / OSGi",
  "description": "Language support for bnd and bndrun files — editor intelligence, bnd CLI, repository browsing, and OSGi resolution analysis",
  "version": "0.19.1",
  "license": "EPL-2.0",
  "publisher": "klibio",
  "icon": "media/swirl-128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/peterkir/vscode-bnd-plugin"
  },
  "bugs": {
    "url": "https://github.com/peterkir/vscode-bnd-plugin/issues"
  },
  "homepage": "https://github.com/peterkir/vscode-bnd-plugin#readme",
  "keywords": [
    "bnd",
    "bndtools",
    "osgi",
    "bndrun",
    "java",
    "bundle",
    "manifest"
  ],
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onFileSystem:bnd-jar"
  ],
  "contributes": {
    "javaExtensions": [
      "./server/jdtls/org.bndtools.jdtls.adapter.jar"
    ],
    "customEditors": [
      {
        "viewType": "bnd.effective",
        "displayName": "Bnd Effective",
        "selector": [
          {
            "filenamePattern": "*.bnd"
          },
          {
            "filenamePattern": "*.bndrun"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "bnd.jarViewer",
        "displayName": "bnd JAR Viewer",
        "selector": [
          {
            "filenamePattern": "*.jar"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bnd",
          "title": "bnd",
          "icon": "media/bndtools-activity.svg"
        }
      ],
      "panel": [
        {
          "id": "bndPanel",
          "title": "Resolution",
          "icon": "media/bndtools.svg"
        }
      ]
    },
    "views": {
      "bnd": [
        {
          "id": "bnd.explorer",
          "name": "Explorer",
          "contextualTitle": "bnd Workspace Files"
        },
        {
          "id": "bnd.repositories",
          "name": "Repositories",
          "icon": "media/bndtools.svg",
          "contextualTitle": "bnd"
        }
      ],
      "bndPanel": [
        {
          "id": "bnd.resolution",
          "name": "Resolution",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "bnd.explorer",
        "contents": "No folder opened.\n[Open Folder](command:workbench.action.files.openFolder)"
      },
      {
        "view": "bnd.repositories",
        "contents": "Repositories require a trusted workspace.\n[Manage Workspace Trust](command:workbench.trust.manage)",
        "when": "!isWorkspaceTrusted"
      },
      {
        "view": "bnd.repositories",
        "contents": "Repositories require the Java bnd Language Server. Set bnd.server.mode to java and make Java 17 or later available.\n[Open Settings](command:workbench.action.openSettings?%22bnd.server.mode%22)\n[Restart Language Server](command:bnd.server.restart)",
        "when": "isWorkspaceTrusted && bnd.repositories.state == unsupported"
      },
      {
        "view": "bnd.repositories",
        "contents": "No bnd workspace found. A bnd workspace contains cnf/build.bnd.",
        "when": "isWorkspaceTrusted && bnd.repositories.state == empty"
      }
    ],
    "languages": [
      {
        "id": "bnd",
        "aliases": [
          "Bnd",
          "bnd"
        ],
        "extensions": [
          ".bnd",
          ".bndrun",
          ".mvn"
        ],
        "filenames": [
          "packageinfo",
          "build.bnd"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bnd",
        "scopeName": "source.bnd",
        "path": "./syntaxes/bnd.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "bnd.explorer.refresh",
        "title": "Refresh Workspace Files",
        "category": "Bnd",
        "icon": "$(refresh)"
