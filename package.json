{
  "name": "bnd",
  "displayName": "bnd / bndtools / OSGi",
  "description": "Language support for bnd and bndrun files — syntax highlighting, IntelliSense completions, hover docs (LSP), and integrated bnd CLI commands",
  "version": "0.12.0",
  "license": "EPL-2.0",
  "publisher": "klibio",
  "icon": "media/swirl-128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/peterkir/vscode-bnd-plugin"
  },
  "bugs": {
    "url": "https://github.com/peterkir/vscode-bnd-plugin/issues"
  },
  "homepage": "https://github.com/peterkir/vscode-bnd-plugin#readme",
  "keywords": [
    "bnd",
    "bndtools",
    "osgi",
    "bndrun",
    "java",
    "bundle",
    "manifest"
  ],
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "bnd.effective",
        "displayName": "Bnd Effective",
        "selector": [
          {
            "filenamePattern": "*.bnd"
          },
          {
            "filenamePattern": "*.bndrun"
          }
        ],
        "priority": "option"
      }
    ],
    "languages": [
      {
        "id": "bnd",
        "aliases": [
          "Bnd",
          "bnd"
        ],
        "extensions": [
          ".bnd",
          ".bndrun",
          ".mvn"
        ],
        "filenames": [
          "packageinfo",
          "build.bnd"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bnd",
        "scopeName": "source.bnd",
        "path": "./syntaxes/bnd.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "bnd.showEffective",
        "title": "Open Effective",
        "category": "Bnd",
        "icon": "$(table)"
      },
      {
        "command": "bnd.showEffectiveToSide",
        "title": "Open Effective to Side",
        "category": "Bnd",
        "icon": "$(open-preview)"
      },
      {
        "command": "bnd.openSource",
        "title": "Open Original Source",
        "category": "Bnd",
        "icon": "$(go-to-file)"
      },
      {
        "command": "bnd.showEffectiveSource",
        "title": "Show Effective Source",
        "category": "Bnd",
        "icon": "$(file-code)"
      },
      {
        "command": "bnd.cli.build",
        "title": "Build Project",
        "category": "Bnd"
      },
      {
        "command": "bnd.cli.run",
        "title": "Run",
        "category": "Bnd"
      },
      {
        "command": "bnd.cli.test",
        "title": "Test Project",
        "category": "Bnd"
      },
      {
        "command": "bnd.cli.runtests",
        "title": "Run OSGi Tests",
        "category": "Bnd"
      },
      {
        "command": "bnd.cli.resolve",
        "title": "Resolve (.bndrun)",
        "category": "Bnd"
      },
      {
        "command": "bnd.cli.clean",
        "title": "Clean Project",
        "category": "Bnd"
      },
      {
        "command": "bnd.cli.baseline",
        "title": "Baseline Check",
        "category": "Bnd"
      },
      {
        "command": "bnd.cli.verify",
        "title": "Verify JARs",
        "category": "Bnd"
      },
      {
        "command": "bnd.cli.print",
        "title": "Print Bundle Info",
        "category": "Bnd"
      },
      {
        "command": "bnd.cli.diff",
        "title": "Diff Bundles",
        "category": "Bnd"
      },
      {
        "command": "bnd.cli.wrap",
        "title": "Wrap JAR as OSGi Bundle",
        "category": "Bnd"
      },
      {
        "command": "bnd.cli.export",
        "title": "Export (.bndrun)",
        "category": "Bnd"
      },
      {
        "command": "bnd.cli.release",
        "title": "Release Project",
        "category": "Bnd"
      },
      {
        "command": "bnd.cli.properties",
        "title": "Show Project Properties",
        "category": "Bnd"
      },
      {
        "command": "bnd.cli.info",
        "title": "Show Project Info",
        "category": "Bnd"
      },
      {
        "command": "bnd.cli.version",
        "title": "Show bnd Version",
        "category": "Bnd"
      },
      {
        "command": "bnd.cli.macro",
        "title": "Evaluate Macro Expression",
        "category": "Bnd"
      },
      {
        "command": "bnd.cli.repo",
        "title": "Repository Commands",
        "category": "Bnd"
      },
      {
        "command": "bnd.cli.configureLib",
        "title": "Configure bnd Library...",
        "category": "Bnd"
      },
      {
        "command": "bnd.cli.selectJavaRuntime",
        "title": "Select Java Runtime for bnd CLI",
        "category": "Bnd"
      },
      {
        "command": "bnd.cli.discoverJavaRuntimes",
        "title": "Discover Java Runtimes from Folder...",
        "category": "Bnd"
      },
      {
        "command": "bnd.cli.showReference",
        "title": "Show CLI Reference",
        "category": "Bnd"
      },
      {
        "command": "bnd.server.restart",
        "title": "Restart Language Server",
        "category": "Bnd"
      },
      {
        "command": "bnd.server.selectJar",
        "title": "Select Language Server JAR...",
        "category": "Bnd"
      },
      {
        "command": "bnd.lsp.resolve",
        "title": "Resolve Runbundles (LSP)",
        "category": "Bnd"
      },
      {
        "command": "bnd.lsp.buildProject",
        "title": "Build Project (LSP)",
        "category": "Bnd"
      },
      {
        "command": "bnd.lsp.expandMacro",
        "title": "Evaluate Macro (LSP)",
        "category": "Bnd"
      }
    ],
    "configuration": {
      "title": "Bnd",
      "properties": {
        "bnd.server.mode": {
          "type": "string",
          "enum": [
            "java",
            "node",
            "socket"
          ],
          "default": "java",
          "description": "Execution mode for the bnd Language Server: 'java' runs the full embedded bndlib server, 'node' runs the lightweight TypeScript server, and 'socket' connects to an existing server on a TCP port."
        },
        "bnd.server.jar": {
          "type": "string",
          "default": "",
          "description": "Optional path to a local biz.aQute.bnd.lsp.jar, e.g. a build output. Takes precedence over bnd.server.jarSource and is launched from a copy so it can be rebuilt while running."
        },
        "bnd.server.jarSource": {
          "type": "string",
          "enum": [
            "bundled",
            "release",
            "snapshot",
            "url"
          ],
          "enumDescriptions": [
            "The JAR shipped with the extension.",
            "A biz.aQute.bnd.lsp release from bnd.cli.mavenRepository (Maven Central), verified against its .sha1 file.",
            "A biz.aQute.bnd.lsp snapshot from bnd.cli.snapshotRepository (bndtools Artifactory), verified against its .sha1 file.",
            "The https URL in bnd.server.jarUrl, optionally verified against bnd.server.jarSha256."
          ],
          "default": "bundled",
          "scope": "machine",
          "description": "Source of the bnd Language Server JAR. Downloads are cached in the extension's global storage and run in the background; until available, the bundled JAR is used. Use 'Bnd: Select Language Server JAR...' to choose."
        },
        "bnd.server.jarVersion": {
          "type": "string",
          "default": "latest",
          "scope": "machine",
          "description": "Version for the 'release' or 'snapshot' source, e.g. 7.5.0 or 7.5.0-SNAPSHOT. 'latest' checks for the newest version on every language server start."
        },
        "bnd.server.jarUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "https URL of a biz.aQute.bnd.lsp JAR for the 'url' source."
        },
        "bnd.server.jarSha256": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "pattern": "^([0-9a-fA-F]{64})?$",
          "description": "Optional SHA-256 of the JAR at bnd.server.jarUrl. The download is rejected on mismatch."
        },
        "bnd.server.javaExecutable": {
          "type": "string",
          "default": "",
          "description": "Java executable used to launch the bnd Language Server. If empty, JAVA_HOME or PATH java is used."
        },
        "bnd.server.jvmArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional JVM arguments to pass when starting the Java Language Server."
        },
        "bnd.server.socketPort": {
          "type": "number",
          "default": 5007,
          "description": "TCP port for socket mode."
        },
        "bnd.cli.executable": {
          "type": "string",
          "default": "bnd",
          "description": "Path or command used to invoke the bnd CLI. Managed automatically by the extension unless you set it yourself. Use 'bnd' if it is on your PATH (e.g. installed via brew), or 'java -jar /path/to/biz.aQute.bnd.jar' to run it as an executable JAR."
        },
        "bnd.cli.mavenRepository": {
          "type": "string",
          "default": "https://repo.maven.apache.org/maven2",
          "description": "Base URL of the Maven repository used to download biz.aQute.bnd release JARs. Change this to a Central-compatible mirror if needed."
        },
        "bnd.cli.snapshotRepository": {
          "type": "string",
          "default": "https://bndtools.jfrog.io/artifactory/libs-snapshot-local",
          "description": "Base URL of the Maven repository used to download biz.aQute.bnd snapshot JARs."
        },
        "bnd.cli.javaExecutable": {
          "type": "string",
          "default": "java",
          "description": "Java executable used when configuring bnd as java -jar. This can point to a specific runtime (for example C:/jdk-21/bin/java.exe)."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "bnd.showEffective",
          "when": "resourceScheme == file && resourceExtname =~ /\\.(bnd|bndrun)$/ && activeCustomEditorId != bnd.effective",
          "group": "navigation"
        },
        {
          "command": "bnd.showEffectiveToSide",
          "when": "resourceScheme == file && resourceExtname =~ /\\.(bnd|bndrun)$/",
          "group": "1_bnd"
        },
        {
          "command": "bnd.openSource",
          "when": "activeCustomEditorId == bnd.effective || resourceScheme == bnd-effective",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "bnd.showEffective",
          "when": "resourceScheme == file && resourceExtname =~ /\\.(bnd|bndrun)$/",
          "group": "bnd"
        },
        {
          "command": "bnd.showEffectiveToSide",
          "when": "resourceScheme == file && resourceExtname =~ /\\.(bnd|bndrun)$/",
          "group": "bnd"
        }
      ],
      "commandPalette": [
        {
          "command": "bnd.cli.build"
        },
        {
          "command": "bnd.cli.run"
        },
        {
          "command": "bnd.cli.test"
        },
        {
          "command": "bnd.cli.runtests"
        },
        {
          "command": "bnd.cli.resolve"
        },
        {
          "command": "bnd.cli.clean"
        },
        {
          "command": "bnd.cli.baseline"
        },
        {
          "command": "bnd.cli.verify"
        },
        {
          "command": "bnd.cli.print"
        },
        {
          "command": "bnd.cli.diff"
        },
        {
          "command": "bnd.cli.wrap"
        },
        {
          "command": "bnd.cli.export"
        },
        {
          "command": "bnd.cli.release"
        },
        {
          "command": "bnd.cli.properties"
        },
        {
          "command": "bnd.cli.info"
        },
        {
          "command": "bnd.cli.version"
        },
        {
          "command": "bnd.cli.macro"
        },
        {
          "command": "bnd.cli.repo"
        },
        {
          "command": "bnd.cli.configureLib"
        },
        {
          "command": "bnd.cli.selectJavaRuntime"
        },
        {
          "command": "bnd.cli.discoverJavaRuntimes"
        },
        {
          "command": "bnd.cli.showReference"
        },
        {
          "command": "bnd.server.restart"
        },
        {
          "command": "bnd.server.selectJar"
        },
        {
          "command": "bnd.lsp.resolve"
        },
        {
          "command": "bnd.lsp.buildProject"
        },
        {
          "command": "bnd.lsp.expandMacro"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "bnd.walkthrough",
        "title": "Get Started with bnd / bndtools",
        "description": "Learn the features of this extension: syntax highlighting, IntelliSense, hover docs, and integrated CLI commands.",
        "steps": [
          {
            "id": "bnd.walkthrough.start",
            "title": "Overview",
            "description": "This extension activates automatically for bnd files and provides syntax highlighting, completions, hover documentation, and 23 integrated bnd CLI commands.",
            "media": {
              "markdown": "walkthroughs/01-getting-started.md"
            }
          },
          {
            "id": "bnd.walkthrough.completions",
            "title": "IntelliSense Completions",
            "description": "Press `Ctrl+Space` on a new line to browse instructions and headers, or type `${` to trigger macro completions.",
            "media": {
              "markdown": "walkthroughs/02-completions.md"
            }
          },
          {
            "id": "bnd.walkthrough.hover",
            "title": "Hover Documentation",
            "description": "Hover over any instruction, header, or macro name to see its signature, description, and a ready-to-use example.",
            "media": {
              "markdown": "walkthroughs/03-hover-docs.md"
            }
          },
          {
            "id": "bnd.walkthrough.cli",
            "title": "Integrated CLI Commands",
            "description": "All bnd CLI commands are available from the Command Palette under the `Bnd:` prefix. The extension downloads and configures the latest bnd release automatically; use Bnd: Configure bnd Library... to switch to another release, a snapshot, or your own URL.",
            "media": {
              "markdown": "walkthroughs/04-cli-commands.md"
            }
          },
          {
            "id": "bnd.walkthrough.reference",
            "title": "CLI Reference Panel",
            "description": "Run **Bnd: Show CLI Reference** to open a searchable panel covering all 77 bnd CLI sub-commands with options and examples.",
            "completionEvents": [
              "onCommand:bnd.cli.showReference"
            ],
            "media": {
              "markdown": "walkthroughs/05-cli-reference.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile:all && npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node20 --minify && esbuild server/src/server.ts --bundle --outfile=server/out/server.js --format=cjs --platform=node --target=node20 --minify",
    "compile": "tsc -p ./tsconfig.json",
    "compile:server": "tsc -p ./server/tsconfig.json",
    "compile:tests": "tsc -p ./tsconfig.test.json",
    "compile:all": "npm run compile && npm run compile:server",
    "pretest": "npm run compile:all && npm run compile:tests",
    "test": "node ./out/test/test/runTest.js",
    "watch": "tsc -watch -p ./",
    "watch:server": "tsc -watch -p ./server/",
    "package": "vsce package --no-git-tag-version",
    "package:prerelease": "vsce package --pre-release --no-git-tag-version",
    "publish": "vsce publish --no-git-tag-version",
    "publish:prerelease": "vsce publish --pre-release --no-git-tag-version"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "http-proxy-agent": "^9.1.0",
    "https-proxy-agent": "^9.1.0",
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.3",
    "@types/vscode": "^1.75.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "mocha": "^11.7.5",
    "typescript": "^7.0.2"
  }
}
